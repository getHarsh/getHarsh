{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/ProjectLayout",
  "definitions": {
    "ProjectLayout": {
      "properties": {
        "homepage_style": {
          "enum": [
            "HOMEPAGE_STYLE_UNSPECIFIED",
            0,
            "HOMEPAGE_STYLE_HERO",
            1,
            "HOMEPAGE_STYLE_DOCUMENTATION",
            2,
            "HOMEPAGE_STYLE_SHOWCASE",
            3,
            "HOMEPAGE_STYLE_CUSTOM",
            4
          ],
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Homepage Style",
          "description": "Homepage layout styles"
        },
        "docs_layout": {
          "enum": [
            "DOCS_LAYOUT_STYLE_UNSPECIFIED",
            0,
            "DOCS_LAYOUT_STYLE_SINGLE_PAGE",
            1,
            "DOCS_LAYOUT_STYLE_MULTI_PAGE",
            2,
            "DOCS_LAYOUT_STYLE_VERSIONED",
            3
          ],
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Docs Layout Style",
          "description": "Documentation layout styles"
        },
        "separate_nav": {
          "type": "boolean",
          "description": "Show project navigation separate from domain nav"
        },
        "sidebar": {
          "$ref": "#/definitions/website.config.DocsSidebar",
          "description": "Sidebar configuration for docs"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Project Layout",
      "description": "Project layout configuration"
    },
    "website.config.DocsSidebar": {
      "properties": {
        "position": {
          "type": "string",
          "description": "Sidebar position (\"left\", \"right\")"
        },
        "collapsible": {
          "type": "boolean",
          "description": "Collapsible sections"
        },
        "mobile_visible": {
          "type": "boolean",
          "description": "Show on mobile"
        },
        "auto_generate": {
          "type": "boolean",
          "description": "Auto-generate from headings"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Docs Sidebar",
      "description": "Documentation sidebar configuration"
    }
  },
  "title": "PROJECTLAYOUT Configuration Schema",
  "description": "JSON Schema for ProjectLayout configuration"
}
