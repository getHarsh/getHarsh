{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/CustomDimension",
  "definitions": {
    "CustomDimension": {
      "properties": {
        "name": {
          "type": "string",
          "description": "Dimension name"
        },
        "index": {
          "type": "integer",
          "description": "Dimension index (GA4)"
        },
        "scope": {
          "enum": [
            "DIMENSION_SCOPE_UNSPECIFIED",
            0,
            "DIMENSION_SCOPE_USER",
            1,
            "DIMENSION_SCOPE_SESSION",
            2,
            "DIMENSION_SCOPE_EVENT",
            3,
            "DIMENSION_SCOPE_ITEM",
            4
          ],
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Dimension Scope",
          "description": "Dimension scope"
        },
        "value_source": {
          "type": "string",
          "description": "Value source"
        },
        "default_value": {
          "type": "string",
          "description": "Default value"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Custom Dimension",
      "description": "Custom dimension configuration"
    }
  },
