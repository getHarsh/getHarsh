{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/FocusManagement",
  "definitions": {
    "FocusManagement": {
      "properties": {
        "focus_traps": {
          "items": {
            "$ref": "#/definitions/website.config.aria.FocusTrap"
          },
          "additionalProperties": false,
          "type": "array",
          "description": "Focus trap zones"
        },
        "restoration": {
          "$ref": "#/definitions/website.config.aria.FocusRestoration",
          "description": "Focus restoration"
        },
        "order": {
          "$ref": "#/definitions/website.config.aria.FocusOrder",
          "description": "Focus order"
        },
        "announcements": {
          "$ref": "#/definitions/website.config.aria.FocusAnnouncements",
          "description": "Focus announcements"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Focus Management",
      "description": "Focus management configuration"
    },
    "website.config.aria.FocusAnnouncements": {
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Announce focus changes"
        },
        "announce_context": {
          "type": "boolean",
          "description": "Context announcements"
        },
        "announce_landmarks": {
          "type": "boolean",
          "description": "Landmark announcements"
        },
        "custom": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object",
          "description": "Custom announcements"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Focus Announcements",
      "description": "Focus announcements"
    },
    "website.config.aria.FocusOrder": {
      "properties": {
        "match_reading_order": {
          "type": "boolean",
