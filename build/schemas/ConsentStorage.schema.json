{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/ConsentStorage",
  "definitions": {
    "ConsentStorage": {
      "properties": {
        "method": {
          "enum": [
            "STORAGE_METHOD_UNSPECIFIED",
            0,
            "STORAGE_METHOD_COOKIE",
            1,
            "STORAGE_METHOD_LOCAL_STORAGE",
            2,
            "STORAGE_METHOD_SERVER",
            3,
            "STORAGE_METHOD_HYBRID",
            4
          ],
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Storage Method",
          "description": "Storage method"
        },
        "cookie": {
          "$ref": "#/definitions/website.config.consent.CookieStorage",
          "description": "Cookie settings"
        },
        "local": {
          "$ref": "#/definitions/website.config.consent.LocalStorage",
          "description": "Local storage settings"
        },
        "server": {
          "$ref": "#/definitions/website.config.consent.ServerStorage",
          "description": "Server storage settings"
        },
        "enable_backup": {
          "type": "boolean",
          "description": "Backup storage"
        },
        "encrypt_storage": {
          "type": "boolean",
          "description": "Storage encryption"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Consent Storage",
      "description": "Consent storage settings"
    },
    "website.config.consent.CookieStorage": {
      "properties": {
        "name": {
          "type": "string",
          "description": "Cookie name"
        },
        "domain": {
          "type": "string",
          "description": "Cookie domain"
        },
        "path": {
          "type": "string",
          "description": "Cookie path"
        },
        "secure": {
          "type": "boolean",
          "description": "Secure flag"
        },
        "same_site": {
          "type": "string",
          "description": "SameSite setting"
        },
        "http_only": {
          "type": "boolean",
          "description": "HttpOnly flag"
        }
