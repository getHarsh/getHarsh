{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/EntityRelationship",
  "definitions": {
    "EntityRelationship": {
      "properties": {
        "from_key": {
          "type": "string",
          "description": "Source entity key (e.g., \"harsh\", \"RTEPL\", \"HENA\")"
        },
        "from_type": {
          "enum": [
            "ENTITY_TYPE_UNSPECIFIED",
            0,
            "ENTITY_TYPE_PERSON",
            1,
            "ENTITY_TYPE_LEGAL_ENTITY",
            2,
            "ENTITY_TYPE_ORGANIZATION",
            3,
            "ENTITY_TYPE_BRAND",
            4,
            "ENTITY_TYPE_PROJECT",
            5,
            "ENTITY_TYPE_COMMUNITY",
            6,
            "ENTITY_TYPE_DOMAIN",
            7,
            "ENTITY_TYPE_BLOG",
            8
          ],
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Entity Type",
          "description": "Entity types for entity relationships"
        },
        "to_key": {
          "type": "string",
          "description": "Target entity key (e.g., \"AION\", \"getHarsh\", \"JARVIS-kernel\")"
        },
        "to_type": {
          "enum": [
            "ENTITY_TYPE_UNSPECIFIED",
            0,
            "ENTITY_TYPE_PERSON",
            1,
            "ENTITY_TYPE_LEGAL_ENTITY",
            2,
            "ENTITY_TYPE_ORGANIZATION",
            3,
            "ENTITY_TYPE_BRAND",
            4,
            "ENTITY_TYPE_PROJECT",
            5,
            "ENTITY_TYPE_COMMUNITY",
            6,
            "ENTITY_TYPE_DOMAIN",
            7,
            "ENTITY_TYPE_BLOG",
            8
          ],
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Entity Type",
          "description": "Entity types for entity relationships"
        },
        "type": {
          "enum": [
            "RELATIONSHIP_TYPE_UNSPECIFIED",
            0,
            "RELATIONSHIP_OWNS",
            1,
            "RELATIONSHIP_OWNED_BY",
            2,
            "RELATIONSHIP_PARENT_ORGANIZATION",
            3,
            "RELATIONSHIP_SUB_ORGANIZATION",
