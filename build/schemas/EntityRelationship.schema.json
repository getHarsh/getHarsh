            "RELATIONSHIP_LEVERAGED_BY",
            32,
            "RELATIONSHIP_EVOLVED_FROM",
            33,
            "RELATIONSHIP_EVOLVES_TO",
            34,
            "RELATIONSHIP_REPLACES",
            35,
            "RELATIONSHIP_REPLACED_BY",
            36,
            "RELATIONSHIP_INTEGRATES_WITH",
            37,
            "RELATIONSHIP_EXTENDS",
            38,
            "RELATIONSHIP_EXTENDED_BY",
            39
          ],
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Relationship Type",
          "description": "Entity relationship types for flexible entity-to-entity relationships Used in EntityRelationship for type-safe relationship definitions"
        },
        "description": {
          "type": "string",
          "description": "Optional description of the relationship"
        },
        "start_date": {
          "type": "string",
          "description": "Start date (ISO 8601 format, e.g., \"2024-01-01\")"
        },
        "end_date": {
          "type": "string",
          "description": "End date (ISO 8601 format, omit if current)"
        },
        "is_current": {
          "type": "boolean",
          "description": "Whether this relationship is currently active"
        },
        "metadata": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object",
          "description": "Additional metadata as key-value pairs Examples: support_type=\"infrastructure\", evolution_stage=\"pivot\""
        },
        "role": {
          "type": "string",
          "description": "Optional role description (e.g., \"Founding Product Manager\")"
        },
        "schema_predicate": {
          "type": "string",
          "description": "Schema.org predicate for this relationship Populated from RelationshipTypeMappings at build time Examples: \"founder\", \"owns\", \"memberOf\", \"worksFor\""
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Entity Relationship",
      "description": "Flexible entity-to-entity relationship definition Supports relationships between any entities in the ecosystem"
    }
  },
  "title": "ENTITYRELATIONSHIP Configuration Schema",
  "description": "JSON Schema for EntityRelationship configuration"
}
