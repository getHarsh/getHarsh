{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/LiveRegionConfig",
  "definitions": {
    "LiveRegionConfig": {
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable this live region"
        },
        "politeness": {
          "enum": [
            "POLITENESS_LEVEL_UNSPECIFIED",
            0,
            "POLITENESS_LEVEL_OFF",
            1,
            "POLITENESS_LEVEL_POLITE",
            2,
            "POLITENESS_LEVEL_ASSERTIVE",
            3
          ],
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Politeness Level",
          "description": "Politeness levels for live regions"
        },
        "atomic": {
          "type": "boolean",
          "description": "Atomic updates"
        },
        "relevant": {
          "type": "string",
          "description": "Relevant changes"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Live Region Config",
      "description": "Live region configuration"
    }
  },
  "title": "LIVEREGIONCONFIG Configuration Schema",
  "description": "JSON Schema for LiveRegionConfig configuration"
}
