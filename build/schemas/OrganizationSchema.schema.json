{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/OrganizationSchema",
  "definitions": {
    "OrganizationSchema": {
      "properties": {
        "name": {
          "type": "string",
          "description": "Organization name"
        },
        "url": {
          "type": "string",
          "description": "Organization URL"
        },
        "logo_url": {
          "type": "string",
          "description": "Logo URL (must be specific dimensions)"
        },
        "same_as": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Same as URLs (social profiles)"
        },
        "contact_point": {
          "$ref": "#/definitions/website.config.ContactPoint",
          "description": "Contact point"
        },
        "founding_date": {
          "type": "string",
          "description": "Founding date"
        },
        "founders": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Founders"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Organization Schema",
      "description": "Organization schema for JSON-LD"
    },
    "website.config.ContactPoint": {
      "properties": {
        "contact_type": {
          "type": "string",
          "description": "Contact type (e.g., \"customer service\")"
        },
        "telephone": {
          "type": "string",
          "description": "Telephone number"
        },
        "email": {
          "type": "string",
          "description": "Email address"
        },
        "available_language": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Available languages"
        },
        "area_served": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Area served"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Contact Point",
      "description": "Contact point for organization"
    }
  },
  "title": "ORGANIZATIONSCHEMA Configuration Schema",
  "description": "JSON Schema for OrganizationSchema configuration"
}
