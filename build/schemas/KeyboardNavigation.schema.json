{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/KeyboardNavigation",
  "definitions": {
    "KeyboardNavigation": {
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable enhanced keyboard navigation"
        },
        "tab_order": {
          "$ref": "#/definitions/website.config.aria.TabOrder",
          "description": "Tab order management"
        },
        "shortcuts": {
          "$ref": "#/definitions/website.config.aria.KeyboardShortcuts",
          "description": "Keyboard shortcuts"
        },
        "patterns": {
          "$ref": "#/definitions/website.config.aria.NavigationPatterns",
          "description": "Navigation patterns"
        },
        "indicators": {
          "$ref": "#/definitions/website.config.aria.KeyboardIndicators",
          "description": "Keyboard indicators"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Keyboard Navigation",
      "description": "Keyboard navigation configuration"
    },
    "website.config.aria.ArrowContext": {
      "properties": {
        "name": {
          "type": "string",
          "description": "Context name (menu, grid, etc.)"
        },
        "selector": {
          "type": "string",
          "description": "CSS selector"
        },
        "type": {
          "enum": [
            "ARROW_NAVIGATION_TYPE_UNSPECIFIED",
            0,
            "ARROW_NAVIGATION_TYPE_HORIZONTAL",
            1,
            "ARROW_NAVIGATION_TYPE_VERTICAL",
            2,
            "ARROW_NAVIGATION_TYPE_GRID",
            3,
            "ARROW_NAVIGATION_TYPE_TREE",
            4
          ],
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Arrow Navigation Type",
          "description": "Arrow navigation types"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Arrow Context",
      "description": "Arrow navigation context"
    },
    "website.config.aria.ArrowNavigation": {
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable arrow navigation"
        },
        "contexts": {
          "items": {
            "$ref": "#/definitions/website.config.aria.ArrowContext"
          },
          "additionalProperties": false,
          "type": "array",
          "description": "Navigation contexts"
        },
        "wrap_around": {
          "type": "boolean",
          "description": "Wrap around"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Arrow Navigation",
      "description": "Arrow navigation configuration"
    },
    "website.config.aria.FocusStyle": {
      "properties": {
        "outline_width": {
          "type": "integer",
          "description": "Outline width"
        },
        "outline_color": {
          "type": "string",
          "description": "Outline color"
        },
        "outline_offset": {
          "type": "integer",
          "description": "Outline offset"
        },
        "custom_css": {
          "type": "string",
          "description": "Custom CSS"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Focus Style",
      "description": "Focus style configuration"
    },
    "website.config.aria.KeyboardIndicators": {
      "properties": {
        "show_focus": {
          "type": "boolean",
          "description": "Show focus indicators"
        },
        "focus_style": {
          "$ref": "#/definitions/website.config.aria.FocusStyle",
          "description": "Focus style"
        },
        "skip_indicators": {
          "type": "boolean",
          "description": "Skip link indicators"
        },
        "active_indication": {
          "type": "boolean",
          "description": "Active element indication"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Keyboard Indicators",
      "description": "Keyboard indicators"
    },
    "website.config.aria.KeyboardShortcuts": {
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable shortcuts"
