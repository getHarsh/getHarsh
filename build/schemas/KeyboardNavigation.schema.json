        },
        "escape_handling": {
          "type": "boolean",
          "description": "Escape key handling"
        },
        "enter_behavior": {
          "type": "string",
          "description": "Enter key behavior"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Navigation Patterns",
      "description": "Navigation patterns"
    },
    "website.config.aria.Shortcut": {
      "properties": {
        "key": {
          "type": "string",
          "description": "Shortcut key combination"
        },
        "action": {
          "type": "string",
          "description": "Action description"
        },
        "context": {
          "type": "string",
          "description": "Context (global, form, etc.)"
        },
        "customizable": {
          "type": "boolean",
          "description": "Customizable"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Shortcut",
      "description": "Individual shortcut"
    },
    "website.config.aria.TabIndexManagement": {
      "properties": {
        "remove_positive": {
          "type": "boolean",
          "description": "Remove positive tabindex"
        },
        "interactive_only": {
          "type": "boolean",
          "description": "Interactive elements only"
        },
        "custom_stops": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Custom tab stops"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Tab Index Management",
      "description": "Tab index management"
    },
    "website.config.aria.TabOrder": {
      "properties": {
        "enforce_logical": {
          "type": "boolean",
          "description": "Logical tab order"
        },
        "skip_hidden": {
          "type": "boolean",
          "description": "Skip hidden elements"
        },
        "tab_index": {
          "$ref": "#/definitions/website.config.aria.TabIndexManagement",
          "description": "Tab index management"
        },
        "show_visualization": {
          "type": "boolean",
          "description": "Tab order visualization"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Tab Order",
      "description": "Tab order configuration"
    }
  },
  "title": "KEYBOARDNAVIGATION Configuration Schema",
  "description": "JSON Schema for KeyboardNavigation configuration"
}
