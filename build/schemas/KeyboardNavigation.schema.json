        "shortcuts": {
          "items": {
            "$ref": "#/definitions/website.config.aria.Shortcut"
          },
          "additionalProperties": false,
          "type": "array",
          "description": "Shortcut list"
        },
        "detect_conflicts": {
          "type": "boolean",
          "description": "Conflict detection"
        },
        "show_help": {
          "type": "boolean",
          "description": "Help dialog"
        },
        "help_key": {
          "type": "string",
          "description": "Help key"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Keyboard Shortcuts",
      "description": "Keyboard shortcuts configuration"
