{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/RSSFeedSettings",
  "definitions": {
    "RSSFeedSettings": {
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable RSS feed generation"
        },
        "path": {
          "type": "string",
          "description": "Feed path (e.g., \"/feed.xml\")"
        },
        "title": {
          "type": "string",
          "description": "Feed title"
        },
        "description": {
          "type": "string",
          "description": "Feed description"
        },
        "post_limit": {
          "type": "integer",
          "description": "Number of posts in feed"
        },
        "full_content": {
          "type": "boolean",
          "description": "Include full content or summary only"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "RSS Feed Settings",
      "description": "RSS feed configuration"
    }
  },
  "title": "RSSFEEDSETTINGS Configuration Schema",
  "description": "JSON Schema for RSSFeedSettings configuration"
}
