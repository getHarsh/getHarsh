{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/StandardEvents",
  "definitions": {
    "StandardEvents": {
      "properties": {
        "page_view": {
          "$ref": "#/definitions/website.config.gtm.PageViewTracking",
          "description": "Page view tracking"
        },
        "engagement": {
          "$ref": "#/definitions/website.config.gtm.UserEngagementTracking",
          "description": "User engagement tracking"
        },
        "search": {
          "$ref": "#/definitions/website.config.gtm.SearchTracking",
          "description": "Search tracking"
        },
        "video": {
          "$ref": "#/definitions/website.config.gtm.VideoTracking",
          "description": "Video tracking"
        },
        "downloads": {
          "$ref": "#/definitions/website.config.gtm.FileDownloadTracking",
          "description": "File download tracking"
        },
        "outbound": {
          "$ref": "#/definitions/website.config.gtm.OutboundLinkTracking",
          "description": "Outbound link tracking"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Standard Events",
      "description": "Standard GA4 events configuration"
    },
    "website.config.gtm.FileDownloadTracking": {
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable download tracking"
        },
        "tracked_extensions": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "File extensions to track"
        },
        "track_source": {
          "type": "boolean",
          "description": "Track download source"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "File Download Tracking",
      "description": "File download tracking"
    },
    "website.config.gtm.OutboundLinkTracking": {
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable outbound tracking"
        },
        "excluded_domains": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Excluded domains (ecosystem domains)"
        },
        "track_context": {
          "type": "boolean",
          "description": "Track link context"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Outbound Link Tracking",
      "description": "Outbound link tracking"
    },
    "website.config.gtm.PageViewTracking": {
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable page view tracking"
        },
        "track_spa_navigation": {
          "type": "boolean",
          "description": "Track single page app navigation"
        },
        "custom_parameters": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object",
          "description": "Include custom parameters"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Page View Tracking",
      "description": "Page view tracking configuration"
    },
    "website.config.gtm.SearchTracking": {
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable search tracking"
        },
        "query_parameter": {
          "type": "string",
          "description": "Search query parameter"
        },
        "track_filters": {
          "type": "boolean",
          "description": "Track search filters"
        },
        "track_results": {
          "type": "boolean",
          "description": "Track search results"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Search Tracking",
      "description": "Search tracking configuration"
    },
    "website.config.gtm.UserEngagementTracking": {
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable engagement tracking"
        },
        "engagement_threshold": {
          "type": "integer",
          "description": "Engagement time threshold (seconds)"
        },
        "track_rage_clicks": {
          "type": "boolean",
          "description": "Track rage clicks"
        },
        "track_dead_clicks": {
          "type": "boolean",
          "description": "Track dead clicks"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "User Engagement Tracking",
      "description": "User engagement tracking"
    },
    "website.config.gtm.VideoTracking": {
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable video tracking"
        },
        "track_youtube": {
          "type": "boolean",
          "description": "Track YouTube videos"
        },
        "track_html5": {
          "type": "boolean",
          "description": "Track HTML5 videos"
        },
        "progress_thresholds": {
          "items": {
            "type": "integer"
          },
          "type": "array",
          "description": "Video interaction thresholds (percentages)"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Video Tracking",
      "description": "Video tracking configuration"
    }
  },
  "title": "STANDARDEVENTS Configuration Schema",
  "description": "JSON Schema for StandardEvents configuration"
}
