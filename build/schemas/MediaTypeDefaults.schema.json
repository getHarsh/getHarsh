{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/MediaTypeDefaults",
  "definitions": {
    "MediaTypeDefaults": {
      "properties": {
        "image": {
          "$ref": "#/definitions/website.config.MediaTypeMapping",
          "description": "MEDIA_TYPE_IMAGE  schema_type: \"ImageObject\" required_properties: [\"contentUrl\", \"name\"] recommended_properties: [\"caption\", \"width\", \"height\", \"thumbnail\"] mime_types: [\"image/jpeg\", \"image/png\", \"image/webp\", \"image/svg+xml\"]"
        },
        "video": {
          "$ref": "#/definitions/website.config.MediaTypeMapping",
          "description": "MEDIA_TYPE_VIDEO  schema_type: \"VideoObject\" required_properties: [\"contentUrl\", \"name\", \"uploadDate\"] recommended_properties: [\"duration\", \"thumbnail\", \"embedUrl\", \"description\"] mime_types: [\"video/mp4\", \"video/webm\"]"
        },
        "audio": {
          "$ref": "#/definitions/website.config.MediaTypeMapping",
          "description": "MEDIA_TYPE_AUDIO  schema_type: \"AudioObject\" required_properties: [\"contentUrl\", \"name\"] recommended_properties: [\"duration\", \"transcript\", \"encodingFormat\"] mime_types: [\"audio/mpeg\", \"audio/ogg\", \"audio/wav\"]"
        },
        "code": {
          "$ref": "#/definitions/website.config.MediaTypeMapping",
          "description": "MEDIA_TYPE_CODE  schema_type: \"SoftwareSourceCode\" required_properties: [\"text\", \"programmingLanguage\"] recommended_properties: [\"codeRepository\", \"runtimePlatform\"]"
        },
        "gist": {
          "$ref": "#/definitions/website.config.MediaTypeMapping",
          "description": "MEDIA_TYPE_GIST  schema_type: \"SoftwareSourceCode\" additional_properties: [\"codeRepository\"] required_properties: [\"text\", \"programmingLanguage\", \"url\"]"
        },
        "diagram": {
          "$ref": "#/definitions/website.config.MediaTypeMapping",
          "description": "MEDIA_TYPE_DIAGRAM  schema_type: \"ImageObject\" additional_types: [\"CreativeWork\"] required_properties: [\"contentUrl\", \"name\", \"encodingFormat\"]"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Media Type Defaults",
      "description": "Predefined media type mappings"
    },
    "website.config.MediaTypeMapping": {
      "properties": {
        "schema_type": {
          "type": "string",
          "description": "Primary Schema.org type"
        },
        "required_properties": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Required properties"
        },
        "recommended_properties": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Recommended properties"
        },
        "mime_types": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "MIME types"
        },
        "file_extensions": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "File extensions"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Media Type Mapping"
    }
  },
  "title": "MEDIATYPEDEFAULTS Configuration Schema",
  "description": "JSON Schema for MediaTypeDefaults configuration"
}
