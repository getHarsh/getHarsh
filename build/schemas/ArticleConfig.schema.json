          "description": "Media attachments"
        },
        "keywords": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "SEO and discovery  SEO keywords"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Content tags/categories"
        },
