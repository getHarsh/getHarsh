            "type": "string"
          },
          "type": "object",
          "description": "Language -> translated article URL"
        },
        "series": {
          "$ref": "#/definitions/website.config.ArticleSeries",
          "description": "Series information (if part of a series)"
        },
        "custom_meta": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object",
          "description": "Custom metadata"
        },
        "is_draft": {
          "type": "boolean",
          "description": "Draft/publish status"
        },
        "is_featured": {
          "type": "boolean"
        },
        "content_warnings": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Content warnings/notices"
        },
        "canonical_url": {
          "type": "string",
          "description": "Canonical URL (if different from generated)"
        },
        "no_index": {
          "type": "boolean",
          "description": "No-index flag (for SEO)"
        },
        "feature_overrides": {
          "$ref": "#/definitions/website.config.ArticleFeatureOverrides",
          "description": "Disable specific features for this article"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "=============================================================================\n ARTICLE CONFIGURATION FOR DECAP CMS\n =============================================================================\n Messages for individual article/post configuration in Decap CMS.\n Replaces Jekyll frontmatter with type-safe proto schema.\n Maps to Schema.org BlogPosting, Article, ScholarlyArticle types.\n =============================================================================",
      "description": "============================================================================= ARTICLE CONFIGURATION FOR DECAP CMS ============================================================================= Messages for individual article/post configuration in Decap CMS. Replaces Jekyll frontmatter with type-safe proto schema. Maps to Schema.org BlogPosting, Article, ScholarlyArticle types. =============================================================================  Individual article configuration for Decap CMS Replaces Jekyll frontmatter with type-safe proto schema Maps to Schema.org BlogPosting, Article types"
    },
