{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/ArticleConfig",
  "definitions": {
    "ArticleConfig": {
      "properties": {
        "title": {
          "type": "string",
          "description": "Basic metadata  Article title (H1)"
        },
        "slug": {
          "type": "string",
          "description": "URL slug"
        },
        "summary": {
          "type": "string",
          "description": "2-3 line summary for meta description"
        },
        "content_type": {
          "enum": [
            "CONTENT_TYPE_UNSPECIFIED",
            0,
            "CONTENT_TYPE_ANNOUNCEMENT",
            1,
            "CONTENT_TYPE_TUTORIAL",
            2,
            "CONTENT_TYPE_DEEP_DIVE",
            3,
            "CONTENT_TYPE_UPDATE",
            4,
            "CONTENT_TYPE_OPINION",
            5,
            "CONTENT_TYPE_CASE_STUDY",
            6,
            "CONTENT_TYPE_REVIEW",
            7,
            "CONTENT_TYPE_GUIDE",
            8,
            "CONTENT_TYPE_INTERVIEW",
            9,
            "CONTENT_TYPE_RESEARCH",
            10,
            "CONTENT_TYPE_ANALYSIS",
            11,
            "CONTENT_TYPE_REFLECTION",
            12,
            "CONTENT_TYPE_EXPERIMENT",
            13,
            "CONTENT_TYPE_ROUNDUP",
            14,
            "CONTENT_TYPE_COMPARISON",
            15,
            "CONTENT_TYPE_CHECKLIST",
            16,
            "CONTENT_TYPE_FAQ",
            17,
            "CONTENT_TYPE_THOUGHT_PIECE",
            18,
            "CONTENT_TYPE_AUDIO_RECORDING",
            19
