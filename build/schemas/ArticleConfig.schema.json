          "description": "Author information (populated by build scripts)  References to persons catalog"
        },
        "date_published": {
          "type": "string",
          "title": "Note: Full author details populated from persons catalog at build time",
          "description": "Note: Full author details populated from persons catalog at build time  Dates  ISO 8601 format"
        },
        "date_modified": {
          "type": "string",
          "description": "ISO 8601 format (optional)"
        },
        "content": {
          "type": "string",
          "description": "Content  Markdown content"
        },
        "reading_time_minutes": {
          "type": "integer",
          "description": "Auto-calculated or manual override"
        },
        "cross_posting": {
          "$ref": "#/definitions/website.config.CrossPostingInfo",
          "description": "Cross-posting configuration"
        },
        "discussion_urls": {
