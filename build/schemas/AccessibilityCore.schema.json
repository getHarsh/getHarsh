    "website.config.aria.CustomLandmark": {
      "properties": {
        "role": {
          "type": "string",
          "description": "Landmark role"
        },
        "label": {
          "type": "string",
          "description": "Landmark label"
        },
        "selector": {
          "type": "string",
          "description": "CSS selector"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Custom Landmark",
      "description": "Custom landmark"
    },
    "website.config.aria.CustomLiveRegion": {
      "properties": {
        "id": {
          "type": "string",
          "description": "Region identifier"
        },
        "selector": {
          "type": "string",
          "description": "CSS selector"
        },
        "config": {
          "$ref": "#/definitions/website.config.aria.LiveRegionConfig",
          "description": "Configuration"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Custom Live Region",
      "description": "Custom live region"
    },
