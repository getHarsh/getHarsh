{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/AccessibilityCore",
  "definitions": {
    "AccessibilityCore": {
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable accessibility features"
        },
        "compliance_level": {
          "enum": [
            "WCAG_LEVEL_UNSPECIFIED",
            0,
            "WCAG_LEVEL_A",
            1,
            "WCAG_LEVEL_AA",
            2,
            "WCAG_LEVEL_AAA",
            3
          ],
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ],
          "title": "WCAG Level",
          "description": "WCAG compliance levels"
        },
        "language": {
          "$ref": "#/definitions/website.config.aria.LanguageSettings",
          "description": "Language settings"
        },
        "skip_links": {
          "$ref": "#/definitions/website.config.aria.SkipLinks",
          "description": "Skip links configuration"
        },
        "landmarks": {
          "$ref": "#/definitions/website.config.aria.Landmarks",
          "description": "Landmarks configuration"
        },
        "live_regions": {
          "$ref": "#/definitions/website.config.aria.LiveRegions",
          "description": "Live regions configuration"
        },
        "error_handling": {
          "$ref": "#/definitions/website.config.aria.ErrorHandling",
          "description": "Error handling"
        },
        "statement": {
          "$ref": "#/definitions/website.config.aria.AccessibilityStatement",
          "description": "Accessibility statement"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Accessibility Core",
      "description": "Core accessibility settings"
    },
    "website.config.aria.AccessibilityStatement": {
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable statement page"
        },
        "url": {
          "type": "string",
          "description": "Statement URL"
        },
        "last_updated": {
          "type": "string",
          "description": "Last updated date"
        },
        "conformance": {
          "type": "string",
          "description": "Conformance level"
        },
        "contact": {
          "type": "string",
          "description": "Contact information"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Accessibility Statement",
      "description": "Accessibility statement"
