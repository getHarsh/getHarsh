          "description": "Banner landmark"
        },
        "complementary": {
          "$ref": "#/definitions/website.config.aria.LandmarkConfig",
          "description": "Complementary landmark"
        },
        "contentinfo": {
          "$ref": "#/definitions/website.config.aria.LandmarkConfig",
          "description": "Content info landmark"
        },
        "search": {
          "$ref": "#/definitions/website.config.aria.LandmarkConfig",
          "description": "Search landmark"
        },
        "custom": {
          "items": {
            "$ref": "#/definitions/website.config.aria.CustomLandmark"
          },
          "additionalProperties": false,
          "type": "array",
          "description": "Custom landmarks"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Landmarks",
      "description": "Landmarks configuration"
    },
    "website.config.aria.LanguageSettings": {
      "properties": {
        "primary_language": {
          "type": "string",
          "description": "Primary language code"
        },
        "direction": {
          "type": "string",
          "description": "Language direction (ltr/rtl)"
        },
        "multi_language": {
          "type": "boolean",
          "description": "Multi-language support"
        },
        "language_switcher_label": {
          "type": "string",
          "description": "Language switcher ARIA"
        },
        "hreflang_enabled": {
          "type": "boolean",
          "description": "Hreflang implementation"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Language Settings",
      "description": "Language settings for accessibility"
