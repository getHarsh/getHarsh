          "description": "Position"
        },
        "z_index": {
          "type": "integer",
          "description": "Z-index"
        },
        "css_class": {
          "type": "string",
          "description": "Custom CSS class"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Skip Link Styling",
      "description": "Skip link styling"
