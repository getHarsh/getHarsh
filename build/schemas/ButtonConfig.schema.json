{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/ButtonConfig",
  "definitions": {
    "ButtonConfig": {
      "properties": {
        "text": {
          "type": "string",
          "description": "Button text"
        },
        "show": {
          "type": "boolean",
          "description": "Show button"
        },
        "style": {
          "enum": [
            "BUTTON_STYLE_UNSPECIFIED",
            0,
            "BUTTON_STYLE_PRIMARY",
            1,
            "BUTTON_STYLE_SECONDARY",
            2,
            "BUTTON_STYLE_TEXT",
            3,
            "BUTTON_STYLE_OUTLINE",
            4
          ],
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Button Style",
          "description": "Button style"
        },
        "css_class": {
          "type": "string",
          "description": "CSS class"
        },
        "aria_label": {
          "type": "string",
          "description": "ARIA label"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Button Config",
      "description": "Button configuration"
    }
  },
  "title": "BUTTONCONFIG Configuration Schema",
  "description": "JSON Schema for ButtonConfig configuration"
}
