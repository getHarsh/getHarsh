{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/SchemaOrgConfig",
  "definitions": {
    "SchemaOrgConfig": {
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable Schema.org JSON-LD generation"
        },
        "mapping_mode": {
          "type": "string",
          "description": "Mapping mode (\"automatic\", \"manual\", \"hybrid\")"
        },
        "include_all_mappings": {
          "type": "boolean",
          "description": "Include all enum mappings in build"
        },
        "included_mappings": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Specific mappings to include (if not including all)"
        },
        "custom_mappings": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object",
          "description": "Custom mapping overrides"
        },
        "validation": {
          "$ref": "#/definitions/website.config.SchemaOrgValidation",
          "description": "Validation settings"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Schema Org Config",
      "description": "Schema.org configuration for build-time mapping"
    },
    "website.config.SchemaOrgValidation": {
      "properties": {
        "validate_types": {
          "type": "boolean",
          "description": "Validate against Schema.org vocabulary"
        },
        "validate_required": {
          "type": "boolean",
          "description": "Validate required properties"
        },
        "allow_custom_properties": {
          "type": "boolean",
          "description": "Allow custom properties"
        },
        "strict_mode": {
          "type": "boolean",
          "description": "Strict mode (fail on warnings)"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Schema Org Validation",
      "description": "Schema.org validation settings"
    }
  },
  "title": "SCHEMAORGCONFIG Configuration Schema",
  "description": "JSON Schema for SchemaOrgConfig configuration"
}
