    "website.config.SchemaOrgValidation": {
      "properties": {
        "validate_types": {
          "type": "boolean",
          "description": "Validate against Schema.org vocabulary"
        },
        "validate_required": {
          "type": "boolean",
          "description": "Validate required properties"
        },
        "allow_custom_properties": {
          "type": "boolean",
          "description": "Allow custom properties"
        },
        "strict_mode": {
          "type": "boolean",
          "description": "Strict mode (fail on warnings)"
        }
      },
      "additionalProperties": false,
      "type": "object",
