        "include_breadcrumbs": {
          "type": "boolean",
          "description": "Include breadcrumbs for all pages"
        },
        "include_site_search": {
          "type": "boolean",
          "description": "Include site search action"
        },
        "default_image_url": {
          "type": "string",
          "description": "Default image for pages without images"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Page Type Defaults",
