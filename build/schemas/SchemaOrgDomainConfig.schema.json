        "contact_type": {
          "type": "string",
          "description": "Contact page type (default: ContactPage)"
        },
        "projects_type": {
          "type": "string",
          "description": "Projects page type (default: CollectionPage)"
        },
        "blog_type": {
          "type": "string",
          "description": "Blog listing type (default: Blog)"
