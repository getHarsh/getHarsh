{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/SchemaOrgManifestConfig",
  "definitions": {
    "SchemaOrgManifestConfig": {
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable Schema.org generation in manifest"
        },
        "include_in_manifest": {
          "type": "boolean",
          "description": "Include in manifest JSON"
        },
        "generate_separate_files": {
          "type": "boolean",
          "description": "Generate separate JSON-LD files"
        },
        "type_mappings": {
          "$ref": "#/definitions/website.config.ManifestTypeMappings",
          "description": "Manifest type mappings"
        },
        "structure_settings": {
          "$ref": "#/definitions/website.config.SiteStructureSettings",
          "description": "Site structure settings"
        },
        "consolidation": {
          "$ref": "#/definitions/website.config.EntityConsolidation",
          "description": "Entity consolidation"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Schema Org Manifest Config",
      "description": "Schema.org manifest configuration"
    },
    "website.config.DefaultManifestTypes": {
      "properties": {
        "default_site_type": {
          "type": "string",
          "description": "Default site type  \"WebSite\""
        },
        "default_page_type": {
          "type": "string",
          "description": "Default page type  \"WebPage\""
        },
        "default_section_type": {
          "type": "string",
          "description": "Default section type  \"WebPageElement\""
        },
        "default_external_type": {
          "type": "string",
          "description": "Default external type  \"ExternalLink\""
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Default Manifest Types",
      "description": "Default manifest types"
    },
    "website.config.EntityConsolidation": {
      "properties": {
        "consolidate_orgs": {
          "type": "boolean",
          "description": "Consolidate organizations"
        },
        "consolidate_persons": {
          "type": "boolean",
          "description": "Consolidate persons"
        },
        "consolidate_brands": {
          "type": "boolean",
          "description": "Consolidate brands"
        },
        "use_id_references": {
          "type": "boolean",
          "description": "Use @id references"
        },
        "id_pattern": {
          "type": "string",
          "description": "ID generation pattern"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Entity Consolidation",
      "description": "Entity consolidation settings"
    },
    "website.config.ManifestTypeMappings": {
      "properties": {
        "site_type_mapping": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object",
          "description": "Site type to Schema.org mapping"
        },
        "node_type_mapping": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object",
          "description": "Node type to Schema.org mapping"
        },
        "format_mapping": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object",
          "description": "Format to encoding mapping"
        },
        "defaults": {
          "$ref": "#/definitions/website.config.DefaultManifestTypes",
          "description": "Default types"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Manifest Type Mappings",
      "description": "Manifest type mappings"
    },
    "website.config.SiteStructureSettings": {
      "properties": {
        "create_website": {
          "type": "boolean",
          "description": "Create WebSite object"
        },
        "create_navigation": {
          "type": "boolean",
          "description": "Create SiteNavigationElement"
        },
        "create_breadcrumbs": {
          "type": "boolean",
          "description": "Create BreadcrumbList"
        },
        "create_item_lists": {
          "type": "boolean",
          "description": "Create ItemList for sections"
        },
        "include_search_action": {
          "type": "boolean",
          "description": "Include search action"
        },
        "max_nav_depth": {
          "type": "integer",
          "description": "Navigation depth"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Site Structure Settings",
      "description": "Site structure settings for Schema.org"
    }
  },
  "title": "SCHEMAORGMANIFESTCONFIG Configuration Schema",
  "description": "JSON Schema for SchemaOrgManifestConfig configuration"
}
