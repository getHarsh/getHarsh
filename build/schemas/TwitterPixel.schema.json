{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/TwitterPixel",
  "definitions": {
    "TwitterPixel": {
      "properties": {
        "pixel_id": {
          "type": "string",
          "description": "Twitter Pixel ID (supports environment variable)"
        },
        "enable_conversion_tracking": {
          "type": "boolean",
          "description": "Enable conversion tracking"
        },
        "enable_website_tag": {
          "type": "boolean",
          "description": "Enable website tag (universal)"
        },
        "twitter_site_tag_id": {
          "type": "string",
          "description": "Twitter site tag ID (for website tag)"
        },
        "track_events": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Event types to track  e.g., [\"PageView\", \"Purchase\", \"AddToCart\"]"
        },
        "enable_enhanced_matching": {
          "type": "boolean",
          "description": "Enable enhanced matching"
        },
        "restricted_data_processing": {
          "type": "boolean",
          "description": "Enable restricted data processing"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Twitter Pixel",
      "description": "Twitter/X Pixel configuration"
    }
  },
  "title": "TWITTERPIXEL Configuration Schema",
  "description": "JSON Schema for TwitterPixel configuration"
}
