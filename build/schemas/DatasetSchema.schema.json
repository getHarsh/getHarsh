        },
        "license": {
          "type": "string",
          "description": "License"
        },
        "temporal_coverage": {
          "type": "string",
          "description": "Temporal coverage"
        },
        "spatial_coverage": {
          "type": "string",
          "description": "Spatial coverage"
        },
        "keywords": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Keywords"
        }
