{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/DecapCMSSettings",
  "definitions": {
    "DecapCMSSettings": {
      "properties": {
        "backend": {
          "$ref": "#/definitions/website.config.DecapBackend",
          "description": "Backend configuration"
        },
        "media_folder": {
          "type": "string",
          "description": "Media folder configuration"
        },
        "public_folder": {
          "type": "string",
          "description": "Public folder for media"
        },
        "editorial_workflow": {
          "$ref": "#/definitions/website.config.EditorialWorkflow",
          "description": "Editorial workflow settings"
        },
        "collections": {
          "$ref": "#/definitions/website.config.ContentCollections",
          "description": "Content collections configuration"
        },
        "preview_styles": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Custom preview styles"
        },
        "custom_widgets": {
          "additionalProperties": {
            "$ref": "#/definitions/website.config.CustomWidget"
          },
          "type": "object",
          "description": "Custom widgets configuration"
        },
        "slug": {
          "$ref": "#/definitions/website.config.SlugConfig",
          "description": "Slug configuration"
        },
        "default_fields": {
          "items": {
            "$ref": "#/definitions/website.config.CMSField"
          },
          "additionalProperties": false,
          "type": "array",
          "description": "Default fields for all collections"
        },
        "gatsby_integration": {
          "$ref": "#/definitions/website.config.GatsbyDecapIntegration",
          "description": "Gatsby integration settings"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Decap CMS Settings",
      "description": "Decap CMS configuration for content management"
