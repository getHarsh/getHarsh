    "website.config.SlugConfig": {
      "properties": {
        "encoding": {
          "type": "string",
          "description": "Slug encoding (\"unicode\", \"ascii\")"
        },
        "clean_accents": {
          "type": "boolean",
          "description": "Clean accents"
        },
        "sanitize_replacement": {
          "type": "string",
          "description": "Sanitize replacement character"
        }
