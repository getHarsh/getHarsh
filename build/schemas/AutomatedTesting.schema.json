{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/AutomatedTesting",
  "definitions": {
    "AutomatedTesting": {
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable automated tests"
        },
        "tools": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Testing tools"
        },
        "test_on_build": {
          "type": "boolean",
          "description": "Test on build"
        },
        "fail_on_errors": {
          "type": "boolean",
          "description": "Fail on errors"
        },
        "error_threshold": {
          "type": "integer",
          "description": "Error threshold"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Automated Testing",
      "description": "Automated testing"
    }
  },
  "title": "AUTOMATEDTESTING Configuration Schema",
  "description": "JSON Schema for AutomatedTesting configuration"
}
