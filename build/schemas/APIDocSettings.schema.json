{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/APIDocSettings",
  "definitions": {
    "APIDocSettings": {
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable API documentation"
        },
        "spec_format": {
          "enum": [
            "API_SPEC_FORMAT_UNSPECIFIED",
            0,
            "API_SPEC_FORMAT_OPENAPI",
            1,
            "API_SPEC_FORMAT_GRAPHQL",
            2,
            "API_SPEC_FORMAT_GRPC",
            3
          ],
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ],
          "title": "API Spec Format",
          "description": "API specification formats"
        },
        "spec_path": {
          "type": "string",
          "description": "Path to API spec file (relative to docs/)"
        },
        "generator": {
          "enum": [
            "API_DOC_GENERATOR_UNSPECIFIED",
            0,
            "API_DOC_GENERATOR_SWAGGER_UI",
            1,
            "API_DOC_GENERATOR_REDOC",
            2,
            "API_DOC_GENERATOR_GRAPHDOC",
            3,
            "API_DOC_GENERATOR_CUSTOM",
            4
          ],
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ],
          "title": "API Doc Generator",
          "description": "API documentation generators (moved from docs.proto)"
        },
        "try_it_out": {
          "type": "boolean",
          "description": "Enable try-it-out feature"
        },
        "api_base_url": {
          "type": "string",
          "description": "Base URL for API calls"
        },
        "auth": {
          "$ref": "#/definitions/website.config.APIAuthConfig",
          "description": "Authentication configuration"
        },
        "code_gen": {
          "$ref": "#/definitions/website.config.CodeGenSettings",
          "description": "Code generation settings"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "API Doc Settings",
      "description": "API documentation settings"
    },
    "website.config.APIAuthConfig": {
      "properties": {
        "type": {
          "enum": [
            "AUTH_TYPE_UNSPECIFIED",
            0,
            "AUTH_TYPE_NONE",
            1,
            "AUTH_TYPE_API_KEY",
            2,
            "AUTH_TYPE_OAUTH2",
            3,
            "AUTH_TYPE_BASIC",
            4
          ],
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Note: APIDocGenerator is imported from project.proto",
          "description": "Note: APIDocGenerator is imported from project.proto  Authentication types"
        },
        "api_key_param": {
          "type": "string",
          "description": "Parameter name for API key"
        },
        "oauth2": {
          "$ref": "#/definitions/website.config.OAuth2Config",
          "description": "OAuth2 configuration"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "API Auth Config",
      "description": "API authentication configuration"
    },
    "website.config.CodeGenSettings": {
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable code examples generation"
        },
        "languages": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Languages to generate examples for"
        },
        "generator": {
          "type": "string",
          "description": "Code generator (\"openapi-generator\", \"custom\")"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Code Gen Settings",
      "description": "Code generation settings"
    },
    "website.config.OAuth2Config": {
      "properties": {
        "flow": {
          "enum": [
            "OAUTH2_FLOW_UNSPECIFIED",
            0,
            "OAUTH2_FLOW_IMPLICIT",
            1,
            "OAUTH2_FLOW_AUTHORIZATION_CODE",
            2,
            "OAUTH2_FLOW_CLIENT_CREDENTIALS",
            3
          ],
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ],
          "title": "O Auth 2 Flow",
          "description": "OAuth2 flow types"
        },
        "auth_url": {
          "type": "string",
          "description": "Authorization URL"
        },
        "token_url": {
          "type": "string",
          "description": "Token URL"
        },
        "scopes": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object",
          "description": "Available scopes"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "O Auth 2 Config",
      "description": "OAuth2 configuration"
    }
  },
  "title": "APIDOCSETTINGS Configuration Schema",
  "description": "JSON Schema for APIDocSettings configuration"
}
