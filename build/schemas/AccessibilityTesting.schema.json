{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/AccessibilityTesting",
  "definitions": {
    "AccessibilityTesting": {
      "properties": {
        "automated": {
          "$ref": "#/definitions/website.config.aria.AutomatedTesting",
          "description": "Automated testing"
        },
        "manual": {
          "$ref": "#/definitions/website.config.aria.ManualTesting",
          "description": "Manual testing"
        },
        "user": {
          "$ref": "#/definitions/website.config.aria.UserTesting",
          "description": "User testing"
        },
        "reporting": {
          "$ref": "#/definitions/website.config.aria.AccessibilityReporting",
          "description": "Reporting"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Accessibility Testing",
      "description": "Accessibility testing configuration"
    },
    "website.config.aria.AccessibilityReporting": {
      "properties": {
        "generate_reports": {
          "type": "boolean",
          "description": "Generate reports"
        },
        "format": {
          "type": "string",
          "description": "Report format"
        },
        "public_reports": {
          "type": "boolean",
          "description": "Public reporting"
        },
        "report_url": {
          "type": "string",
          "description": "Report URL"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Accessibility Reporting",
      "description": "Accessibility reporting"
    },
    "website.config.aria.AutomatedTesting": {
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable automated tests"
        },
        "tools": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Testing tools"
        },
        "test_on_build": {
          "type": "boolean",
          "description": "Test on build"
        },
        "fail_on_errors": {
          "type": "boolean",
          "description": "Fail on errors"
        },
        "error_threshold": {
          "type": "integer",
          "description": "Error threshold"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Automated Testing",
      "description": "Automated testing"
    },
    "website.config.aria.ManualTesting": {
      "properties": {
        "checklist_url": {
          "type": "string",
          "description": "Checklist URL"
        },
        "schedule": {
          "type": "string",
          "description": "Testing schedule"
        },
        "key_workflows": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Key workflows"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Manual Testing",
      "description": "Manual testing"
    },
    "website.config.aria.UserTesting": {
      "properties": {
        "include_pwd": {
          "type": "boolean",
          "description": "Include users with disabilities"
        },
        "frequency": {
          "type": "string",
          "description": "Testing frequency"
        },
        "collect_feedback": {
          "type": "boolean",
          "description": "Feedback collection"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "User Testing",
      "description": "User testing"
    }
  },
  "title": "ACCESSIBILITYTESTING Configuration Schema",
  "description": "JSON Schema for AccessibilityTesting configuration"
}
