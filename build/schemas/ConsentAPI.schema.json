{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/ConsentAPI",
  "definitions": {
    "ConsentAPI": {
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable API"
        },
        "endpoints": {
          "$ref": "#/definitions/website.config.consent.APIEndpoints",
          "description": "API endpoints"
        },
        "auth": {
          "$ref": "#/definitions/website.config.consent.APIAuth",
          "description": "Authentication"
        },
        "rate_limiting": {
          "$ref": "#/definitions/website.config.consent.RateLimiting",
          "description": "Rate limiting"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Consent API",
      "description": "Consent API configuration"
    },
    "website.config.consent.APIAuth": {
      "properties": {
        "type": {
          "enum": [
            "AUTH_TYPE_UNSPECIFIED",
            0,
            "AUTH_TYPE_NONE",
            1,
            "AUTH_TYPE_API_KEY",
            2,
            "AUTH_TYPE_JWT",
            3,
            "AUTH_TYPE_OAUTH2",
            4
          ],
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Auth Type",
          "description": "Auth type"
        },
        "api_key_header": {
          "type": "string",
          "description": "API key header"
        },
        "jwt": {
          "$ref": "#/definitions/website.config.consent.JWTSettings",
          "description": "JWT settings"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "API Auth",
      "description": "API authentication"
    },
    "website.config.consent.APIEndpoints": {
      "properties": {
        "get_consent": {
          "type": "string",
          "description": "Get consent endpoint"
        },
        "update_consent": {
          "type": "string",
          "description": "Update consent endpoint"
        },
        "delete_consent": {
          "type": "string",
          "description": "Delete consent endpoint"
        },
        "export_data": {
          "type": "string",
          "description": "Export data endpoint"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "API Endpoints",
      "description": "API endpoints"
    },
    "website.config.consent.JWTSettings": {
      "properties": {
        "secret": {
          "type": "string",
          "description": "JWT secret"
        },
        "algorithm": {
          "type": "string",
          "description": "JWT algorithm"
        },
        "expiry_seconds": {
          "type": "integer",
          "description": "JWT expiry (seconds)"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "JWT Settings",
      "description": "JWT settings"
    },
    "website.config.consent.RateLimiting": {
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable rate limiting"
        },
        "requests_per_minute": {
          "type": "integer",
          "description": "Requests per minute"
        },
        "burst_limit": {
          "type": "integer",
          "description": "Burst limit"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Rate Limiting",
      "description": "Rate limiting"
    }
  },
  "title": "CONSENTAPI Configuration Schema",
  "description": "JSON Schema for ConsentAPI configuration"
}
