          "description": "Language support"
        },
        "abbreviations": {
          "$ref": "#/definitions/website.config.aria.AbbreviationsAcronyms",
          "description": "Abbreviations and acronyms"
        }
      },
      "additionalProperties": false,
      "type": "object",
