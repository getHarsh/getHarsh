{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/OAuth2Config",
  "definitions": {
    "OAuth2Config": {
      "properties": {
        "flow": {
          "enum": [
            "OAUTH2_FLOW_UNSPECIFIED",
            0,
            "OAUTH2_FLOW_IMPLICIT",
            1,
            "OAUTH2_FLOW_AUTHORIZATION_CODE",
            2,
            "OAUTH2_FLOW_CLIENT_CREDENTIALS",
            3
          ],
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ],
          "title": "O Auth 2 Flow",
          "description": "OAuth2 flow types"
        },
        "auth_url": {
          "type": "string",
          "description": "Authorization URL"
        },
        "token_url": {
          "type": "string",
          "description": "Token URL"
        },
        "scopes": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object",
          "description": "Available scopes"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "O Auth 2 Config",
      "description": "OAuth2 configuration"
    }
  },
  "title": "OAUTH2CONFIG Configuration Schema",
  "description": "JSON Schema for OAuth2Config configuration"
}
