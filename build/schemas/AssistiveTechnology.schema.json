{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/AssistiveTechnology",
  "definitions": {
    "AssistiveTechnology": {
      "properties": {
        "screen_readers": {
          "$ref": "#/definitions/website.config.aria.ScreenReaderSupport",
          "description": "Screen reader optimization"
        },
        "voice_control": {
          "$ref": "#/definitions/website.config.aria.VoiceControlSupport",
          "description": "Voice control support"
        },
        "switch_devices": {
          "$ref": "#/definitions/website.config.aria.SwitchDeviceSupport",
          "description": "Switch device support"
        },
        "magnification": {
          "$ref": "#/definitions/website.config.aria.MagnificationSupport",
          "description": "Magnification support"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Assistive Technology",
      "description": "Assistive technology support"
    },
    "website.config.aria.MagnificationSupport": {
      "properties": {
        "reflow_content": {
          "type": "boolean",
          "description": "Reflow content"
        },
        "high_res_images": {
          "type": "boolean",
          "description": "High resolution images"
        },
        "avoid_horizontal": {
          "type": "boolean",
          "description": "Avoid horizontal scroll"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Magnification Support",
      "description": "Magnification support"
    },
    "website.config.aria.ScreenReaderAnnouncements": {
      "properties": {
        "announce_dynamic": {
          "type": "boolean",
          "description": "Dynamic content"
        },
        "announce_states": {
          "type": "boolean",
          "description": "State changes"
        },
        "announce_pages": {
          "type": "boolean",
          "description": "Page changes"
        },
        "custom": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object",
          "description": "Custom announcements"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Screen Reader Announcements",
      "description": "Screen reader announcements"
    },
    "website.config.aria.ScreenReaderSupport": {
      "properties": {
        "optimize": {
          "type": "boolean",
          "description": "Optimize for screen readers"
        },
        "tested_with": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Tested screen readers"
        },
        "announcements": {
          "$ref": "#/definitions/website.config.aria.ScreenReaderAnnouncements",
          "description": "Announcements"
        },
        "virtual_cursor": {
          "type": "boolean",
          "description": "Virtual cursor support"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Screen Reader Support",
      "description": "Screen reader support"
    },
    "website.config.aria.SwitchDeviceSupport": {
      "properties": {
        "switch_scanning": {
          "type": "boolean",
          "description": "Switch scanning"
        },
        "scan_speed_ms": {
          "type": "integer",
          "description": "Scanning speed"
        },
        "patterns": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Scanning patterns"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Switch Device Support",
      "description": "Switch device support"
    },
    "website.config.aria.VoiceCommand": {
      "properties": {
        "phrase": {
          "type": "string",
          "description": "Command phrase"
        },
        "action": {
          "type": "string",
          "description": "Action"
        },
        "context": {
          "type": "string",
          "description": "Context"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Voice Command",
      "description": "Voice command"
    },
    "website.config.aria.VoiceControlSupport": {
      "properties": {
        "voice_navigation": {
          "type": "boolean",
          "description": "Voice navigation"
        },
        "commands": {
          "items": {
            "$ref": "#/definitions/website.config.aria.VoiceCommand"
          },
          "additionalProperties": false,
          "type": "array",
          "description": "Voice commands"
        },
        "number_overlays": {
          "type": "boolean",
          "description": "Number overlays"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Voice Control Support",
      "description": "Voice control support"
    }
