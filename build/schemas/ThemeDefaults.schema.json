{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/ThemeDefaults",
  "definitions": {
    "ThemeDefaults": {
      "properties": {
        "theme_mapping": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object",
          "description": "Maps domain names to theme IDs if different from default"
        },
        "available_themes": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Available theme IDs in the system"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Theme Defaults",
      "description": "Default theme settings inherited by all domains"
    }
  },
  "title": "THEMEDEFAULTS Configuration Schema",
  "description": "JSON Schema for ThemeDefaults configuration"
}
