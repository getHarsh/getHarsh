{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/MotionSettings",
  "definitions": {
    "MotionSettings": {
      "properties": {
        "respect_preference": {
          "type": "boolean",
          "description": "Respect prefers-reduced-motion"
        },
        "controls": {
          "$ref": "#/definitions/website.config.aria.AnimationControls",
          "description": "Animation controls"
        },
        "prevent_autoplay": {
          "type": "boolean",
          "description": "Auto-play prevention"
        },
        "disable_parallax": {
          "type": "boolean",
          "description": "Parallax effects"
        },
        "optional_smooth_scroll": {
          "type": "boolean",
          "description": "Smooth scrolling"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Motion Settings",
      "description": "Motion settings"
    },
    "website.config.aria.AnimationControls": {
      "properties": {
        "allow_pause": {
          "type": "boolean",
          "description": "Pause animations"
        },
        "speed_control": {
          "type": "boolean",
          "description": "Animation speed"
        },
        "disable_option": {
          "type": "boolean",
          "description": "Disable all animations"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Animation Controls",
      "description": "Animation controls"
    }
  },
  "title": "MOTIONSETTINGS Configuration Schema",
  "description": "JSON Schema for MotionSettings configuration"
}
